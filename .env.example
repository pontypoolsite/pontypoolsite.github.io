# Set this in the Neon Function's server-side environment using a restricted
# catalog role; see README for the required table/sequence grants.
DATABASE_URL=postgresql://STOREFRONT_USER:REPLACE_WITH_PASSWORD@HOST/DATABASE?sslmode=require

# These are server-only. Never prefix them with VITE_.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD
ADMIN_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Public Neon Function URL used by the Vite website. This URL is not a secret.
VITE_STOREFRONT_API_URL=https://YOUR_STOREFRONT_FUNCTION_URL

# Public contact details used to build order messages; use international digits.
VITE_WHATSAPP_NUMBER=
VITE_INSTAGRAM_URL=
